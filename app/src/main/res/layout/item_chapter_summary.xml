<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/chapterSummaryContainer"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Chapter Name (Sanskrit) -->
        <TextView
            android:id="@+id/chapterName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="अर्जुनविषादयोग"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="?attr/colorPrimary"
            app:layout_constraintTop_toTopOf="parent"/>

        <!-- Chapter Name Translation -->
        <TextView
            android:id="@+id/chapterNameTranslation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Arjun Viṣhād Yog"
            android:textSize="18sp"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:alpha="0.8"
            app:layout_constraintTop_toBottomOf="@id/chapterName"/>

        <!-- Chapter Meaning -->
        <TextView
            android:id="@+id/chapterMeaning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Arjuna's Dilemma"
            android:textSize="16sp"
            android:textStyle="italic"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:alpha="0.7"
            app:layout_constraintTop_toBottomOf="@id/chapterNameTranslation"/>

        <!-- Verses Count -->
        <TextView
            android:id="@+id/versesCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="47 verses"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:alpha="0.6"
            app:layout_constraintTop_toBottomOf="@id/chapterMeaning"/>

        <!-- Divider -->
        <View
            android:id="@+id/divider1"
            android:layout_width="100dp"
            android:layout_height="2dp"
            android:background="?attr/colorPrimary"
            android:alpha="0.3"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/versesCount"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Hindi Summary Label -->
        <TextView
            android:id="@+id/summaryHindiLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="सारांश"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/divider1"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Hindi Summary -->
        <TextView
            android:id="@+id/summaryHindi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hindi summary"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/summaryHindiLabel"/>

        <!-- Divider -->
        <View
            android:id="@+id/divider2"
            android:layout_width="100dp"
            android:layout_height="2dp"
            android:background="?attr/colorPrimary"
            android:alpha="0.3"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/summaryHindi"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- English Summary Label -->
        <TextView
            android:id="@+id/summaryEnglishLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Summary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/divider2"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- English Summary -->
        <TextView
            android:id="@+id/summaryEnglish"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="English summary"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="12dp"
            android:paddingBottom="32dp"
            app:layout_constraintTop_toBottomOf="@id/summaryEnglishLabel"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
