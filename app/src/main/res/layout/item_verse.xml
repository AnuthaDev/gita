<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/verseContainer"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Speaker Indicator -->
        <TextView
            android:id="@+id/speakerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Krishna"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:alpha="0.7"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Verse Title (Chapter.Verse) -->
        <TextView
            android:id="@+id/verseTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Verse 1.1"
            android:textSize="14sp"
            android:alpha="0.7"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/speakerName"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Speaker Prefix (उवाच line) - Small font -->
        <TextView
            android:id="@+id/speakerPrefix"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="श्री भगवानुवाच"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            android:textStyle="italic"
            android:gravity="center"
            android:alpha="0.7"
            android:visibility="gone"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/verseTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Sanskrit Shloka -->
        <TextView
            android:id="@+id/sanskritText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Sanskrit shloka will appear here"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@id/speakerPrefix"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Divider -->
        <View
            android:id="@+id/divider"
            android:layout_width="80dp"
            android:layout_height="2dp"
            android:background="@color/text_secondary"
            android:alpha="0.3"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/sanskritText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Word Meanings Section (Collapsible) -->
        <LinearLayout
            android:id="@+id/wordMeaningsHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="8dp"
            android:layout_marginTop="16dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            app:layout_constraintTop_toBottomOf="@id/divider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="शब्दार्थ (Word Meanings)"
                android:textSize="13sp"
                android:textStyle="bold"
                android:alpha="0.7"/>

            <TextView
                android:id="@+id/wordMeaningsToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" ▼"
                android:textSize="12sp"
                android:alpha="0.7"
                android:layout_marginStart="4dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/wordMeanings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Word meanings will appear here"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            android:padding="12dp"
            android:visibility="gone"
            android:alpha="0.8"
            app:layout_constraintTop_toBottomOf="@id/wordMeaningsHeader"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Hindi Translation Label -->
        <TextView
            android:id="@+id/hindiLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="अनुवाद"
            android:textSize="12sp"
            android:alpha="0.6"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/wordMeanings"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Hindi Translation -->
        <TextView
            android:id="@+id/hindiTranslation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Hindi translation will appear here"
            android:textSize="18sp"
            android:gravity="center"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/hindiLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Transliteration (initially hidden) -->
        <TextView
            android:id="@+id/transliteration"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Transliteration"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            android:gravity="center"
            android:visibility="gone"
            android:alpha="0.7"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/hindiTranslation"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
